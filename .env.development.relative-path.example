# 相对路径配置示例
# 本文件展示如何使用相对路径配置 VITE_APP_AXIOS_BASEURL
# 
# 使用方法：
# 1. 复制本文件内容到 .env.development
# 2. 在 vite.config.ts 中启用对应的 proxy 配置
# 3. 重启开发服务器

# 开发环境
NODE_ENV = "development"
VITE_APP_MODE = "development"

# 配置单页应用的基路径 (Router base属性)
VITE_APP_ROUTER_BASE = "/h5/"

# 静态文件打包存放的目录 (vite.base属性)
VITE_APP_PUBLIC_URL = "/"

# 【重点】使用相对路径配置请求地址
# 所有API请求都会发送到：当前域名 + VITE_APP_AXIOS_BASEURL + 接口路径
# 例如：http://localhost:23001/api/mock/14/demo/vue3-h5-tmp-v2-info
# 然后通过vite.config.ts中的proxy配置转发到实际的后端地址
VITE_APP_AXIOS_BASEURL = "/api"

# 代理目标域名（在vite.config.ts的proxy中使用）
VITE_APP_PROXY_URL = "https://mock.127516.com"

# 启用vconsole
VITE_APP_ENABLE_VCONSOLE = 0

# 删除所有console.log
VITE_APP_PURE_CONSOLE = 0

# 删除所有断点（debugger）
VITE_APP_DROP_DEBUGGER = 0

# 启用 Vue DevTools
VITE_APP_ENABLE_VUE_DEVTOOLS = 0

# 传统浏览器兼容
VITE_APP_LEGACY = 0

# ============================================
# vite.config.ts 中对应的 proxy 配置示例：
# ============================================
# server: {
#   host: '0.0.0.0',
#   port: 23001,
#   proxy: {
#     '/api': {
#       target: 'https://mock.127516.com',
#       changeOrigin: true,
#       rewrite: (path) => path.replace(/^\/api/, ''),
#     },
#   },
# },
# ============================================
