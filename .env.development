# 开发环境
NODE_ENV = "development"
VITE_APP_MODE = "development"

# 配置单页应用的基路径 (Router base属性)
# 默认值: "/"，应用的基路径。例如，如果整个单页应用服务在 /app/ 下，然后 base 就应该设为 "/app/"
VITE_APP_ROUTER_BASE = "/h5/"

# 静态文件打包存放的目录 (vite.base属性)
VITE_APP_PUBLIC_URL = "/"

# 请求地址，支持绝对路径和相对路径
# 绝对路径示例: "https://mock.127516.com" 或 "http://localhost:3000"
# 相对路径示例: "/api" 或 "/proxy_url"（相对于当前域名，常用于开发环境proxy转发）
# 注：使用相对路径时，请求会发送到当前应用所在域名，如需转发到其他域名，请在vite.config.ts中配置proxy
VITE_APP_AXIOS_BASEURL = "https://mock.127516.com"

# 代理域名，注：使用devServer.proxy时，需要设置 VITE_APP_AXIOS_BASEURL = "/proxy_url"
# 然后在vite.config.ts的server.proxy中配置转发规则
VITE_APP_PROXY_URL = "https://mock.127516.com"

#启用vconsole 参数说明：0表示不启用；1表示启用
VITE_APP_ENABLE_VCONSOLE = 0

# 删除所有console.log。 参数说明：0表示不启用；1表示启用
VITE_APP_PURE_CONSOLE = 0

# 删除所有断点（debugger）。 参数说明：0表示不启用；1表示启用
VITE_APP_DROP_DEBUGGER = 0

# 启用 Vue DevTools（面板渲染在页面内，手机 H5 也可直接点开调试）。0=关闭；1=开启
VITE_APP_ENABLE_VUE_DEVTOOLS = 0

# 传统浏览器兼容（legacy 构建 + polyfills）。默认开启；0=关闭；1=开启
VITE_APP_LEGACY = 0
