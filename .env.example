# 环境变量示例文件
# 复制此文件并重命名为 .env.development / .env.test / .env.production 使用

# ===== 基础配置 =====
NODE_ENV = "production"
VITE_APP_MODE = "production"

# ===== 路由配置 =====
# 配置单页应用的基路径 (Router base属性)
# 默认值: "/"，应用的基路径。例如，如果整个单页应用服务在 /app/ 下，然后 base 就应该设为 "/app/"
VITE_APP_ROUTER_BASE = "/"

# 静态文件打包存放的目录 (vite.base属性)
VITE_APP_PUBLIC_URL = "/"

# ===== API 请求地址配置 =====
# 重要：根据实际部署情况选择以下三种配置方式之一

# 方式一：前后端同域名部署（推荐）
# 使用相对路径，无需跨域配置，域名变更无需修改配置
# 示例：前端部署在 https://example.com，设置为 /api
# 实际请求：https://example.com/api/xxx
VITE_APP_AXIOS_BASEURL = "/api"

# 方式二：前后端不同域名部署
# 使用完整URL地址，需要后端配置 CORS 跨域支持
# 示例：前端在 https://www.example.com，后端在 https://api.example.com
# VITE_APP_AXIOS_BASEURL = "https://api.example.com"

# 方式三：开发环境代理配置（仅用于开发环境）
# 开发时使用代理解决跨域问题，需要在 vite.config.ts 中配置 proxy
# VITE_APP_AXIOS_BASEURL = "/proxy_url"
# VITE_APP_PROXY_URL = "https://api.example.com"

# ===== 调试配置 =====
# 启用vconsole 参数说明：0表示不启用；1表示启用
VITE_APP_ENABLE_VCONSOLE = 0

# 删除所有console.log。 参数说明：0表示不启用；1表示启用
VITE_APP_PURE_CONSOLE = 1

# 删除所有断点（debugger）。 参数说明：0表示不启用；1表示启用
VITE_APP_DROP_DEBUGGER = 1

# 启用 Vue DevTools。0=关闭；1=开启（生产环境建议 0）
VITE_APP_ENABLE_VUE_DEVTOOLS = 0

# ===== 构建配置 =====
# 构建版本号，用于在构建产物文件名中添加版本标识
VITE_APP_BUILD_VERSION = "v1.0.0"

# 传统浏览器兼容（legacy 构建 + polyfills）。默认开启；0=关闭；1=开启
VITE_APP_LEGACY = 0

# 启用打包体积分析插件（rollup-plugin-visualizer），参数说明：0表示不启用；1表示启用
# 注：该命令旨在分析捆绑包大小，会减慢打包速度，非必要莫要开启
VITE_APP_BUNDLE_ANALYZE = 0
